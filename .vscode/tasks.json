{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: Native (Release)",
      "type": "shell",
      "command": "python3",
      "args": [
        ".vscode/build.py",
        "--target",
        "native",
        "--mode",
        "release"
      ],
      "windows": {
        "command": "${workspaceFolder}\\.vscode\\build.cmd",
        "args": [
          "--target",
          "native",
          "--mode",
          "release"
        ],
        "options": {
          "shell": {
            "executable": "${env:ComSpec}",
            "args": [
              "/d",
              "/c"
            ]
          }
        }
      },
      "linux": {
        "command": "python3"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
